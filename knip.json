{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/**/page.tsx",
    "app/**/layout.tsx"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "stores/**/*.{ts,tsx}"
  ],
  "ignoreDependencies": [
    "autoprefixer"
  ],
  "rules": {
    "exports": "off",
    "types": "off",
    "duplicates": "off",
    "unlisted": "off"
  }
}
